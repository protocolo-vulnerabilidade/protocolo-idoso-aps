# Variáveis de ambiente — Protocolo Idoso APS
# Copie para .env (ou configure na plataforma de deploy) e ajuste os valores.
# O .env real é ignorado pelo git; este arquivo é apenas documentação.

# ---- Backend (apps/backend) ----
# Conexão PostgreSQL (usuário:senha@host:porta/banco)
DATABASE_URL=postgresql://piaps_dev:piaps_dev@localhost:5432/protocolo_idoso_dev

# Porta em que a API escuta
PORTA=8080

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGENS=http://localhost:5173,http://localhost:4173

# ---- Frontend (apps/frontend) ----
# URL base da API (injetada em tempo de build pelo Vite)
VITE_API_URL=http://localhost:8080
